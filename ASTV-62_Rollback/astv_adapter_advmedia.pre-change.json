{
  "script_id": "astv_adapter_advmedia",
  "config_hash": "1ddc07631782c3a4",
  "category": "01KY5BCDDWE2CK0HM5RT0KXTNX",
  "config": {
    "alias": "ASTV - Adapter: AdvMedia",
    "description": "Calls AdvMedia to prepare playback and returns only the playback payload expected by ASTV.",
    "mode": "parallel",
    "max": 10,
    "fields": {
      "media_item_id": {
        "name": "Media Item ID",
        "description": "Identifier of the media item within the selected catalogue.",
        "required": true,
        "selector": { "text": {} }
      },
      "media_catalogue": {
        "name": "Media Catalogue",
        "description": "Catalogue containing the requested media item.",
        "required": true,
        "selector": { "text": {} }
      },
      "media_player": {
        "name": "Media Player",
        "description": "Target media player entity.",
        "required": true,
        "selector": { "entity": { "domain": "media_player" } }
      },
      "media_profile": {
        "name": "Media Profile",
        "description": "Optional explicit mediaprofile_* override. When omitted, AdvMedia resolves the profile from the media player.",
        "required": false,
        "selector": { "text": {} }
      }
    },
    "sequence": [
      {
        "action": "script.advmedia_prepare_playback",
        "data": {
          "media_item_id": "{{ media_item_id }}",
          "media_catalogue": "{{ media_catalogue }}",
          "media_player": "{{ media_player }}",
          "media_profile": "{{ media_profile | default('', true) }}"
        },
        "response_variable": "advmedia_response"
      },
      {
        "variables": {
          "payload_response": "{{ advmedia_response.playback_payload }}"
        }
      },
      {
        "stop": "ASTV playback payload returned",
        "response_variable": "payload_response"
      }
    ]
  }
}
