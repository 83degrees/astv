{
  "script_id": "astv_g_home_device_engine",
  "config_hash": "32dba34e015c9156",
  "category": "01K9QMV1C04YWV4HAS8G6V7FRV",
  "config": {
    "alias": "ASTV - Google Home Device Engine",
    "description": "Executes an ASTV request through a Google Home device endpoint.",
    "mode": "parallel",
    "max": 10,
    "fields": {
      "request": {
        "name": "Request",
        "description": "The complete ASTV request object.",
        "required": true,
        "selector": {
          "object": {}
        }
      },
      "selected_endpoint": {
        "name": "Selected Endpoint",
        "description": "The resolved Google Home device endpoint.",
        "required": true,
        "selector": {
          "object": {}
        }
      }
    },
    "sequence": [
      {
        "variables": {
          "request_intent": "{{ request.intent }}",
          "endpoint_phrase": "{{ selected_endpoint.phrase }}",
          "g_home_device_request_object": "{{ request.params.sources.g_home_device }}"
        }
      },
      {
        "action": "script.astv_provider_g_assist",
        "data": {
          "intent": "{{ request_intent }}",
          "request_object": "{{ g_home_device_request_object }}",
          "endpoint_phrase": "{{ endpoint_phrase }}"
        },
        "response_variable": "provider_command_response"
      },
      {
        "action": "google_assistant_sdk.send_text_command",
        "metadata": {},
        "data": {
          "command": "{{ provider_command_response.command }}"
        }
      }
    ]
  }
}
