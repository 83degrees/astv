{
  "script_id": "astv_intent_engine_media",
  "config_hash": "af4f068ab94770a3",
  "config": {
    "alias": "ASTV - Intent Engine: Media",
    "description": "",
    "fields": {
      "request": {
        "selector": {
          "object": {}
        },
        "name": "Request",
        "required": true,
        "description": "The UID object found for the scanned UID."
      },
      "target_area": {
        "selector": {
          "text": {}
        },
        "name": "Target Area",
        "required": true,
        "description": "The area resolved for this ASTV request."
      }
    },
    "sequence": [
      {
        "action": "script.astv_find_area_domain_endpoints",
        "metadata": {},
        "data": {
          "domain": "{{ request.params.output.domain }}",
          "area": "{{ target_area }}"
        },
        "response_variable": "area_domain_response"
      },
      {
        "action": "script.astv_resolve_playback_method",
        "metadata": {},
        "data": {
          "preferences": "{{ area_domain_response.preference }}",
          "available_sources": "{{ request.params.sources }}"
        },
        "response_variable": "playback_method_response"
      },
      {
        "action": "script.astv_select_area_playback_endpoint",
        "metadata": {},
        "data": {
          "area_playback_domain": "{{ area_domain_response }}",
          "playback_method": "{{ playback_method_response.selected_source }}"
        },
        "response_variable": "area_playback_endpoint_response"
      },
      {
        "action": "script.astv_select_media_engine",
        "data": {
          "request": "{{ request }}",
          "playback_endpoint": "{{ area_playback_endpoint_response }}"
        }
      }
    ],
    "mode": "parallel",
    "max": 10
  }
}
