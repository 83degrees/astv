{
  "script_id": "astv_select_intent_engine",
  "config_hash": "b61a25f53d8c67a2",
  "config": {
    "alias": "ASTV - Select Intent Engine",
    "description": "",
    "fields": {
      "request": {
        "selector": { "object": {} },
        "name": "Request",
        "required": true,
        "description": "The UID object found for the scanned UID."
      },
      "target_area": {
        "selector": { "text": {} },
        "name": "Target Area",
        "required": true,
        "description": "The area resolved for this ASTV request."
      }
    },
    "sequence": [
      {
        "variables": {
          "intent": "{{ request.intent }}",
          "intent_path": "{{ intent.split('.') }}"
        }
      },
      {
        "alias": "Choose Intent Engine based on intent_path",
        "choose": [
          {
            "conditions": [
              {
                "condition": "template",
                "value_template": "{{ intent_path[0] == 'media' }}"
              }
            ],
            "sequence": [
              {
                "action": "script.astv_intent_engine_media",
                "metadata": {},
                "data": {
                  "request": "{{ request }}",
                  "target_area": "{{ target_area }}"
                }
              }
            ],
            "alias": "Media.*"
          },
          {
            "conditions": [
              {
                "condition": "template",
                "value_template": "{{ intent_path[0] == 'routine' }}"
              }
            ],
            "sequence": [
              {
                "action": "script.astv_g_automation_engine",
                "metadata": {},
                "data": {
                  "routine": "{{ request.routine }}",
                  "target_area": "{{ target_area }}"
                }
              }
            ],
            "alias": "Routine.*"
          }
        ],
        "default": [
          {
            "action": "notify.persistent_notification",
            "metadata": {},
            "data": {
              "message": "No intent recognised for:\n\nTitle: {{ request.title }}\nIntent: {{ intent }}\nIntent Path: {{ intent_path }}",
              "title": "Intent not recognised"
            }
          }
        ]
      }
    ],
    "mode": "parallel",
    "max": 10
  }
}
