{
  "script_id": "astv_g_automation_engine",
  "config_hash": "6aa39b6b39d12378",
  "category": "01K9QMV1C04YWV4HAS8G6V7FRV",
  "config": {
    "alias": "ASTV - Google Automation Engine",
    "description": "Resolves and activates the Google automation trigger for a routine and target area.",
    "mode": "parallel",
    "max": 10,
    "fields": {
      "request": {"name": "Request", "description": "The complete ASTV request object.", "required": true, "selector": {"object": {}}},
      "target_area": {"name": "Target Area", "description": "The resolved Home Assistant area ID.", "required": true, "selector": {"text": {}}}
    },
    "sequence": [
      {
        "action": "script.astv_find_routine_trigger",
        "data": {"routine": "{{ request.routine }}", "target_area": "{{ target_area }}"},
        "response_variable": "trigger_response"
      },
      {
        "if": [{"condition": "template", "value_template": "{{ trigger_response.entity_id | default('') == '' }}"}],
        "then": [
          {"action": "notify.persistent_notification", "data": {"title": "ASTV - Google Automation Engine", "message": "No Google automation trigger was found for routine '{{ request.routine }}' in area '{{ target_area }}'."}},
          {"stop": "No routine trigger found", "error": true}
        ]
      },
      {"action": "input_boolean.turn_on", "target": {"entity_id": "{{ trigger_response.entity_id }}"}}
    ]
  }
}
