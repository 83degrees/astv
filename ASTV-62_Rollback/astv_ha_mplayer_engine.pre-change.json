{
  "script_id": "astv_ha_mplayer_engine",
  "config_hash": "62a363022c26ca89",
  "category": "01K9QMV1C04YWV4HAS8G6V7FRV",
  "config": {
    "alias": "ASTV - HA Media Player Engine",
    "description": "",
    "mode": "parallel",
    "max": 10,
    "fields": {
      "request": {
        "name": "Request",
        "description": "The UID object found for the scanned UID.",
        "required": true,
        "selector": { "object": {} }
      },
      "selected_endpoint": {
        "name": "Selected Endpoint",
        "selector": { "object": {} }
      },
      "execution_method": {
        "name": "Execution Method",
        "description": "The ASTV-selected execution method carried for normalized media context.",
        "required": false,
        "selector": { "text": {} }
      },
      "media_record": {
        "name": "Media Record",
        "description": "The complete normalized MediaCat returned record carried unchanged when supplied.",
        "required": false,
        "selector": { "object": {} }
      }
    },
    "sequence": [
      {
        "variables": {
          "media_player_entity": "{{ selected_endpoint.media_entity }}",
          "ha_mplayer_request_object": "{{ request.params.sources.ha_mplayer }}"
        }
      },
      {
        "action": "script.astv_handle_provider",
        "data": {
          "request_object": "{{ ha_mplayer_request_object }}",
          "media_player": "{{ media_player_entity }}"
        },
        "enabled": true,
        "response_variable": "provider_payload_response"
      },
      {
        "action": "media_player.play_media",
        "target": { "entity_id": "{{ media_player_entity }}" },
        "data": "{{ provider_payload_response }}"
      }
    ]
  }
}
