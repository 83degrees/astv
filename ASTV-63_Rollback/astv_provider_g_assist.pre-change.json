{
  "script_id": "astv_provider_g_assist",
  "config_hash": "09cdf48a46000450",
  "category": "01KY5BCDDWE2CK0HM5RT0KXTNX",
  "config": {
    "alias": "ASTV - Provider: Google Assist",
    "description": "Builds a Google Assistant command using the command builder appropriate to the ASTV intent.",
    "mode": "parallel",
    "max": 10,
    "fields": {
      "intent": {
        "name": "Intent",
        "description": "The ASTV intent being executed.",
        "required": true,
        "selector": { "text": {} }
      },
      "request_object": {
        "name": "Request Object",
        "description": "The g_home_device source request object.",
        "required": true,
        "selector": { "object": {} }
      },
      "endpoint_phrase": {
        "name": "Endpoint Phrase",
        "description": "The resolved Google Home device phrase.",
        "required": true,
        "selector": { "text": {} }
      }
    },
    "sequence": [
      {
        "variables": {
          "provider_data_object": "{{ request_object.data }}"
        }
      },
      {
        "choose": [
          {
            "alias": "Media command",
            "conditions": [
              {
                "condition": "template",
                "value_template": "{{ intent == 'media.play_source' }}"
              }
            ],
            "sequence": [
              {
                "action": "script.astv_cmd_builder_media",
                "data": {
                  "phrase": "{{ provider_data_object.phrase }}",
                  "append_target": "{{ provider_data_object.get('append_target', true) }}",
                  "endpoint_phrase": "{{ endpoint_phrase }}"
                },
                "response_variable": "command_response"
              },
              {
                "stop": "Google Assistant command built",
                "response_variable": "command_response"
              }
            ]
          }
        ],
        "default": [
          {
            "action": "notify.persistent_notification",
            "data": {
              "title": "ASTV - Provider: Google Assist",
              "message": "No Google Assistant command builder is available for intent: {{ intent }}"
            }
          },
          {
            "stop": "Unsupported Google Assistant intent",
            "error": true
          }
        ]
      }
    ]
  }
}
