{
  "script_id": "astv_adapter_advmedia",
  "config_hash": "fe00d0cea795cc06",
  "category": "01KY5BCDDWE2CK0HM5RT0KXTNX",
  "config": {
    "alias": "ASTV - Adapter: AdvMedia",
    "description": "Routes one complete legacy catalogue-reference or normalized media-record request to AdvMedia and returns only the playback payload expected by ASTV.",
    "mode": "parallel",
    "max": 10,
    "fields": {
      "media_item_id": {
        "name": "Media Item ID",
        "description": "Identifier of the media item within the selected catalogue on the legacy v1 path.",
        "required": false,
        "selector": { "text": {} }
      },
      "media_catalogue": {
        "name": "Media Catalogue",
        "description": "Catalogue containing the requested media item on the legacy v1 path.",
        "required": false,
        "selector": { "text": {} }
      },
      "media_record": {
        "name": "Media Record",
        "description": "Complete normalized MediaCat returned record on the v2 path.",
        "required": false,
        "selector": { "object": {} }
      },
      "selected_execution_method": {
        "name": "Selected Execution Method",
        "description": "Execution method already selected by ASTV on the v2 path.",
        "required": false,
        "selector": { "text": {} }
      },
      "media_player": {
        "name": "Media Player",
        "description": "Target media player entity.",
        "required": true,
        "selector": { "entity": { "domain": "media_player" } }
      },
      "media_profile": {
        "name": "Media Profile",
        "description": "Optional explicit mediaprofile_* override. When omitted, AdvMedia resolves the profile from the media player.",
        "required": false,
        "selector": { "text": {} }
      }
    },
    "sequence": [
      {
        "variables": {
          "v1_catalogue_supplied": "{{ media_catalogue is defined }}",
          "v1_item_supplied": "{{ media_item_id is defined }}",
          "v2_record_supplied": "{{ media_record is defined }}",
          "v2_method_supplied": "{{ selected_execution_method is defined }}"
        }
      },
      {
        "variables": {
          "v1_any": "{{ v1_catalogue_supplied or v1_item_supplied }}",
          "v1_complete": "{{ v1_catalogue_supplied and v1_item_supplied }}",
          "v2_any": "{{ v2_record_supplied or v2_method_supplied }}",
          "v2_complete": "{{ v2_record_supplied and v2_method_supplied }}"
        }
      },
      {
        "choose": [
          {
            "alias": "Reject mixed v1 and v2 request",
            "conditions": [
              { "condition": "template", "value_template": "{{ v1_any and v2_any }}" }
            ],
            "sequence": [
              { "stop": "ASTV AdvMedia adapter request mixes v1 and v2 input shapes", "error": true }
            ]
          },
          {
            "alias": "Current v1 catalogue-reference path",
            "conditions": [
              { "condition": "template", "value_template": "{{ v1_complete and not v2_any }}" }
            ],
            "sequence": [
              {
                "action": "script.advmedia_prepare_playback",
                "data": {
                  "media_item_id": "{{ media_item_id }}",
                  "media_catalogue": "{{ media_catalogue }}",
                  "media_player": "{{ media_player }}",
                  "media_profile": "{{ media_profile | default('', true) }}"
                },
                "response_variable": "advmedia_response"
              },
              { "variables": { "payload_response": "{{ advmedia_response.playback_payload }}" } },
              { "stop": "ASTV playback payload returned", "response_variable": "payload_response" }
            ]
          },
          {
            "alias": "Approved-target v2 normalized-record path",
            "conditions": [
              { "condition": "template", "value_template": "{{ v2_complete and not v1_any }}" }
            ],
            "sequence": [
              {
                "action": "script.advmedia_process_media_record",
                "data": {
                  "media_record": "{{ media_record }}",
                  "selected_execution_method": "{{ selected_execution_method }}",
                  "media_player": "{{ media_player }}",
                  "media_profile": "{{ media_profile | default('', true) }}"
                },
                "response_variable": "advmedia_response"
              },
              { "variables": { "payload_response": "{{ advmedia_response.playback_payload }}" } },
              { "stop": "ASTV playback payload returned", "response_variable": "payload_response" }
            ]
          }
        ],
        "default": [
          { "stop": "ASTV AdvMedia adapter requires one complete v1 or v2 input shape", "error": true }
        ]
      }
    ]
  }
}
