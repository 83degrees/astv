{
  "script_id": "astv_select_intent_engine",
  "config_hash": "325c73773e53f0ab",
  "category": "01K9QMV1C04YWV4HAS8G6V7FRV",
  "config": {
    "alias": "ASTV - Select Intent Engine",
    "description": "",
    "fields": {
      "request": {"selector": {"object": {}}, "name": "Request", "required": true, "description": "The UID object found for the scanned UID."},
      "target_area": {"selector": {"text": {}}, "name": "Target Area", "required": true, "description": "The area resolved for this ASTV request."}
    },
    "sequence": [
      {"variables": {"intent": "{{ request.intent }}", "intent_path": "{{ intent.split('.') }}"}},
      {
        "alias": "Choose Intent Engine based on intent_path",
        "choose": [
          {
            "conditions": [{"condition": "template", "value_template": "{{ intent_path[0] == 'media' }}"}],
            "sequence": [{"action": "script.astv_intent_engine_media", "metadata": {}, "data": {"request": "{{ request }}", "target_area": "{{ target_area }}"}}],
            "alias": "Media.*"
          },
          {
            "conditions": [{"condition": "template", "value_template": "{{ intent_path[0] == 'routine' }}"}],
            "sequence": [
              {"action": "script.astv_intent_engine_routine", "metadata": {}, "data": {"request": "{{ request }}", "target_area": "{{ target_area }}"}, "response_variable": "routine_intent_response"},
              {"action": "script.astv_select_execution_engine", "data": {"execution_method": "{{ routine_intent_response.execution_method }}", "request": "{{ routine_intent_response.request }}", "target_area": "{{ routine_intent_response.target_area }}", "selected_endpoint": "{{ routine_intent_response.selected_endpoint }}"}}
            ],
            "alias": "Routine.*"
          }
        ],
        "default": [{"action": "notify.persistent_notification", "metadata": {}, "data": {"message": "No intent recognised for:\n\nTitle: {{ request.title }}\nIntent: {{ intent }}\nIntent Path: {{ intent_path }}", "title": "Intent not recognised"}}]
      }
    ],
    "mode": "parallel",
    "max": 10
  }
}
